# ==============================================================================
# Creda API — Environment Variables Template
# Copy this file to .env and provide your production or local credentials.
# ==============================================================================

# Project & Environment
PROJECT_NAME="Creda API"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Database
# Local SQLite default: sqlite:///./creda_dev.db
# Production Supabase/PostgreSQL: postgresql://postgres.xxxx:password@host:5432/postgres
DATABASE_URL="sqlite:///./creda_dev.db"

# Supabase Storage & Database (Optional for cloud storage of CV PDFs)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-or-anon-key"

# OpenAI API Key (For AI Skill Extraction & Job Matching)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-3.5-turbo"

# GitHub Personal Access Token (Optional: increases rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN="ghp_your_github_token_here"

# Security & JWT Authentication
JWT_SECRET="generate-a-strong-random-32-character-secret-key-here"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=24

# CORS Allowed Origins (Comma-separated or list)
# Default allows localhost:3000, localhost:5173 (Vite/Next.js)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
